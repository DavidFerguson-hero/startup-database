# ─────────────────────────────────────────────────────────────────────────────
# Startup Scout — environment variables
#
# Copy this file to .env for local development (never commit .env).
# On AWS, store these in Secrets Manager and inject via ECS task definition.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────

# A long random string used to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — if unset the app generates a new one on each restart
# (which invalidates all active sessions).
SECRET_KEY=replace-with-64-hex-chars

# Fallback shared password for the single-password login screen.
# If unset, the app falls back to the hardcoded default "edf2024".
# Set to a strong value in production; or leave unset once per-user accounts
# (users.py) are fully rolled out.
APP_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────

# Absolute path to the directory that holds all persistent data:
#   Startup database.xlsx, users.json, collections.json, startups/
# Defaults to the directory the app lives in (fine for local dev).
# On AWS, set this to the EFS mount point, e.g. /data
DATA_DIR=/data

# ── Server ────────────────────────────────────────────────────────────────────

# Port gunicorn listens on. The Dockerfile sets this to 8080; the ALB forwards
# HTTPS → HTTP on this port. Only change if you have a conflicting service.
PORT=8080

# ── Email (AWS SES recommended in production) ─────────────────────────────────
# Used for: email verification on sign-up, password reset links.
# If SMTP_HOST is empty, emails are logged to stdout but not actually sent
# (safe for local dev; will break sign-up flow in production).

# SES SMTP endpoint, e.g. email-smtp.eu-west-1.amazonaws.com
SMTP_HOST=

# SES SMTP port — 587 (STARTTLS) recommended
SMTP_PORT=587

# SES SMTP credentials — generate in the SES console under "SMTP Settings"
# These are NOT your AWS access keys; they are separate SES-specific credentials.
SMTP_USER=
SMTP_PASS=

# The From address shown to recipients. Must be a verified SES sender.
SMTP_FROM=startupscout@yourdomain.com

# ── AI features ───────────────────────────────────────────────────────────────

# Anthropic API key — used by the AI augmentation routes (/api/ai/*).
# Get yours at https://console.anthropic.com
# If unset, the AI routes return errors but the rest of the app works fine.
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional integrations ─────────────────────────────────────────────────────

# Base URL for SharePoint startup folders, e.g.:
#   https://yourcompany.sharepoint.com/sites/Innovation/Shared%20Documents/Startups
# If set, "Open folder" buttons link here instead of trying to open a local path.
# Leave blank if not using SharePoint.
SHAREPOINT_FOLDER_BASE=
